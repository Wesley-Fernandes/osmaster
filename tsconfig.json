{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "osmaster": ["./src/index"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "demo", "test_lib_usage.ts"]
}
